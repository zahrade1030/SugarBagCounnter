<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Primary Colors -->
        <item name="colorPrimary">#245A45</item>
        <item name="colorPrimaryVariant">#173D30</item>
        <item name="colorSecondary">#E6A23C</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorOnSecondary">#101714</item>

        <!-- Background -->
        <item name="android:windowBackground">#101714</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">#142B23</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">#142B23</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Font -->
        <item name="android:fontFamily">sans</item>

        <!-- UI -->
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>

    </style>

</resources>
